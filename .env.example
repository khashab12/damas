# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.

# Public base URL, used to build the payment return/cancel URLs.
APP_BASE_URL=http://localhost:3000

# ---- Database (required) ---------------------------------------------------
# Pooled Postgres connection string. Neon recommended; Supabase works too.
# Use the POOLED endpoint, not the direct one - serverless opens many
# short-lived connections and would exhaust a direct endpoint.
#
#   Neon:     postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#   Supabase: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Schema lives in lib/orders/schema.sql and is applied automatically on first
# use; you can also run it by hand:  psql "$DATABASE_URL" -f lib/orders/schema.sql
DATABASE_URL=

# Orders are cash on delivery/pickup - there is no payment provider.

# ---- Restaurant WhatsApp notification (optional) ---------------------------
# WhatsApp Cloud API (Meta, first-party). Leave both blank and new orders are
# only written to the server log -- the app still works, nobody is paged.
# Full setup walkthrough: README, "Restaurant WhatsApp notifications".
#
# From Meta -> your app -> WhatsApp -> API Setup:
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User token. The 24-hour test token WILL expire on you.
WHATSAPP_ACCESS_TOKEN=

# Who gets the order. Defaults to the restaurant's number (0574672565).
# Any Saudi format works: 0574672565 / +966574672565 / 966574672565.
# Point this at your own mobile while testing.
WHATSAPP_TO=

# Name of the APPROVED message template. Strongly recommended for production:
# without it we send free-form text, which WhatsApp only delivers if the
# recipient messaged the business number within the last 24 hours. With it,
# delivery works at any hour. See the README for the exact body to submit.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar

# Graph API version. Defaults to v23.0; pin it deliberately when upgrading.
WHATSAPP_API_VERSION=
