# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.

# Public base URL, used to build the payment return/cancel URLs.
APP_BASE_URL=http://localhost:3000

# ---- Database (required) ---------------------------------------------------
# Pooled Postgres connection string. Neon recommended; Supabase works too.
# Use the POOLED endpoint, not the direct one - serverless opens many
# short-lived connections and would exhaust a direct endpoint.
#
#   Neon:     postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#   Supabase: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Schema lives in lib/orders/schema.sql and is applied automatically on first
# use; you can also run it by hand:  psql "$DATABASE_URL" -f lib/orders/schema.sql
DATABASE_URL=

# Orders are cash on delivery/pickup - there is no payment provider.
