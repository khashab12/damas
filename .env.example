# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.

# Public base URL, used to build the payment return/cancel URLs.
APP_BASE_URL=http://localhost:3000

# ---- Payment provider (see lib/payment.ts) --------------------------------
# Secret API key. Server-side only — do NOT prefix with NEXT_PUBLIC_.
PAYMENT_API_KEY=
# Shared secret used to verify webhook signatures.
PAYMENT_WEBHOOK_SECRET=
# Provider base URL, e.g. https://api.moyasar.com/v1
PAYMENT_API_BASE_URL=

# ---- Storage --------------------------------------------------------------
# SQLite file. Point at a mounted volume in production.
ORDERS_DB_PATH=.data/orders.db
